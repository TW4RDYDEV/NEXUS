{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "version": "1.0.0",
  "identifier": "app.twardy.nexus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "NEXUS",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#090a0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Offensive Security Engagement Platform",
    "category": "DeveloperTool"
  }
}